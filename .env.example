# ==============================================================================
# TraceLedger – Tamper-Resistant Sample Lifecycle Tracking & Audit System
# PostgreSQL & Flask Configuration
# ==============================================================================

# PostgreSQL Database Connection Settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=traceledger_db

# Flask Application Settings
FLASK_SECRET_KEY=traceledger_super_secret_session_key_2026_change_in_production
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000
